# .env.example
# This is a TEMPLATE for your settings. It's safe to share because it has no real keys.
#
# How to use it:
#   1. Copy it:   cp .env.example .env
#   2. Open .env and paste your real keys after each "=".
#   3. NEVER commit .env (it's listed in .gitignore, so git ignores it).
#
# app/config.py reads these values. Comments have to be on their own line.


# NVIDIA Nemotron on Nebius Token Factory (it works like the OpenAI API)

# Get a key at https://tokenfactory.nebius.com/ (on the API keys page)
NEBIUS_API_KEY=

# Base URL from the Nebius docs: https://docs.tokenfactory.nebius.com/switch
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# The Nemotron we use for live checks. Lightning is fast and cheap.
# (Model IDs come from the Nebius catalog, checked Oct 2026.)
NEMOTRON_MODEL=nvidia/Nemotron-3_5-Lightning

# A bigger, smarter Nemotron for harder jobs, like writing alerts in Haitian
# Creole. Ultra is the biggest one. Leave it blank to always use NEMOTRON_MODEL.
NEMOTRON_SMART_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b


# Tavily (web search for caller numbers and scam warnings)

# Get a key at https://app.tavily.com/
TAVILY_API_KEY=


# Twilio (phone number, calls and texts)

# Both are on the front page of https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Our Twilio phone number, in +1XXXXXXXXXX format (E.164)
TWILIO_PHONE_NUMBER=

# An API key, so the senior's calling app (static/phone.html) can receive
# calls. Make one at console.twilio.com -> Account -> API keys & tokens.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Landlines only: the SIP domain the senior's phone adapter signs in to,
# e.g. scamshield.sip.twilio.com (Voice -> Manage -> SIP domains).
TWILIO_SIP_DOMAIN=

# The phone that gets the test text (scripts/test_sms.py).
# On a Twilio trial account this has to be a "Verified Caller ID".
TEST_SMS_TO_NUMBER=


# App settings

# true means we play scripted calls as "live" transcripts (no real phone call needed)
DEMO_MODE=true

# The public web address of our server. Twilio needs this to reach us.
# On your computer it's localhost. For real calls we'll use an ngrok URL later.
PUBLIC_BASE_URL=http://localhost:8000

# File where we save sign-ups (and the senior's YES/NO answer) and calls.
# Leave blank to use data/scam_shield.db. It's in .gitignore: it holds real
# phone numbers, so it must never be uploaded.
DATABASE_PATH=


# Gmail (sends the family alert by email)

# The Scam Shield Gmail address the alerts come from
GMAIL_ADDRESS=

# Not your normal Gmail password! Turn on 2-Step Verification, then make an
# app password at https://myaccount.google.com/apppasswords and paste the 16 letters.
GMAIL_APP_PASSWORD=


# Supabase (family logins: sign up and log in to the dashboard)

# Make a free project at https://supabase.com/, then copy both values from
# Project Settings, then API Keys. Older projects call the publishable key the
# "anon" key. It's safe to show in the browser, that's what it's made for.
# Leave both blank to turn login off (the dashboard is then open to anyone).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
