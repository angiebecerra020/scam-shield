# .env.example — a TEMPLATE for your settings. Safe to share (no real keys).
#
# How to use it:
#   1. Copy it:   cp .env.example .env
#   2. Open .env and paste your real keys after each "=".
#   3. NEVER commit .env (it's listed in .gitignore, so git ignores it).
#
# app/config.py reads these values. Comments must be on their own line.

# ---------------------------------------------------------------------------
# NVIDIA Nemotron via Nebius Token Factory (OpenAI-compatible API)
# ---------------------------------------------------------------------------
# Get a key at https://tokenfactory.nebius.com/ (API keys page)
NEBIUS_API_KEY=

# Base URL from the Nebius docs: https://docs.tokenfactory.nebius.com/switch
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model ID from the Nebius catalog (checked Oct 2026).
#   nvidia/Nemotron-3_5-Lightning      -> fast + cheap (our default, for live calls)
#   nvidia/nemotron-3-super-120b-a12b  -> smarter, but slower
NEMOTRON_MODEL=nvidia/Nemotron-3_5-Lightning

# ---------------------------------------------------------------------------
# Tavily (web search: caller number lookups + current scam news)
# ---------------------------------------------------------------------------
# Get a key at https://app.tavily.com/
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Twilio (phone number, calls, SMS)
# ---------------------------------------------------------------------------
# Both are on the front page of https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Our Twilio phone number, in +1XXXXXXXXXX format (E.164)
TWILIO_PHONE_NUMBER=

# Phone that receives the test SMS (scripts/test_sms.py).
# On a Twilio trial account this must be a "Verified Caller ID".
TEST_SMS_TO_NUMBER=

# ---------------------------------------------------------------------------
# App settings
# ---------------------------------------------------------------------------
# true = play scripted calls as "live" transcripts (no real phone call needed)
DEMO_MODE=true

# Public web address of our server. Twilio needs this to reach us.
# Locally it's localhost; for real calls we'll use an ngrok URL (later step).
PUBLIC_BASE_URL=http://localhost:8000

# File where we save sign-ups (and the senior's YES/NO answer) and calls.
# Leave blank to use data/scam_shield.db. It's in .gitignore: it holds real
# phone numbers, so it must never be uploaded.
DATABASE_PATH=
